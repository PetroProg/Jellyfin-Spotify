# Server Configuration
PORT=5050
NODE_ENV=production
DB_PATH=/app/data/app.db
MUSIC_DIR=/app/music

# Security
JWT_SECRET=change-this-to-a-secure-random-token-key

# Jellyfin Integration
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_PUBLIC_URL=http://100.107.4.120:8096

# Notification for Admin (when registered users >= 5)
NOTIFY_PHONE_IP=100.76.188.111
NOTIFY_PHONE_URL=http://100.76.188.111:8080/api/notification

# Spotify Web API (Optional for enhanced recommendations)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Weekly Listening Report & Gmail SMTP (Sundays 12:00 Europe/Zurich)
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_TO=your-report-email@gmail.com
WEEKLY_REPORT_TIMEZONE=Europe/Zurich
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_HOUR=12
WEEKLY_REPORT_MINUTE=0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=changeme_gmail_app_password
SMTP_FROM="Jellyfy Reports <your-sender@gmail.com>"
